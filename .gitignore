# macOS
.DS_Store

# Xcode: user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode: build output
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods / Carthage (not used, guarded anyway)
Pods/
Carthage/Build/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Provisioning and signing secrets (never commit)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Rendered submission artefacts. The diagram sources are tracked
# (docs/architecture.mmd and docs/mermaid-config.json, rendered to
# docs/architecture.png), and the report itself is submitted as a PDF exported from
# MoveProof_Assessment3_Report.docx rather than built by this repository.
# Track a rendered artefact anyway with: git add -f <file>
/MoveProof_Assessment3_Report_Draft.docx
/*.pdf
