# macOS
.DS_Store

# Xcode: user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode: build output
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods / Carthage (not used, guarded anyway)
Pods/
Carthage/Build/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Provisioning and signing secrets (never commit)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Rendered submission artefacts. The sources are tracked: docs/*.md for the prose,
# docs/architecture.mmd and docs/mermaid-config.json for the diagram. The Word draft
# and the PDF exported from it are rebuilt from those, so they are not kept in Git.
# Track one anyway with: git add -f <file>
/MoveProof_Assessment3_Report_Draft.docx
/*.pdf
