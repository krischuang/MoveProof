# macOS
.DS_Store

# Xcode: user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode: build output
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods / Carthage (not used, guarded anyway)
Pods/
Carthage/Build/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Provisioning and signing secrets (never commit)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Rendered submission artefacts. Two are tracked on purpose: the final report at
# docs/MoveProof_Assessment3_Report.pdf, and docs/architecture.png, the diagram
# embedded in it. The Word source the PDF is exported from is kept outside this
# repository rather than built by it, so a stray PDF at the root stays ignored.
# Track a rendered artefact anyway with: git add -f <file>
/MoveProof_Assessment3_Report_Draft.docx
/*.pdf
