%% MoveProof: platform-integrated architecture and primary evidence-capture flow
%% .
%% Render (high resolution, for the report):
%%   npx -y @mermaid-js/mermaid-cli@11 -i docs/architecture.mmd \
%%     -o docs/architecture.png -c docs/mermaid-config.json -b white -s 3
%% or paste into https://mermaid.live
%% .
%% Reads top to bottom. The top row is outside the app, so the boundary between the
%% renter and the system is explicit. Each downward arrow inside the main app is a
%% layer the code may not skip, and the numbers follow one real workflow: the renter
%% attaches a photograph to a condition item, and the Home Screen widget catches up
%% with it. READ and WRITE are labelled on every arrow crossing into the App Group.
%% .
%% The dashed ViewModel to Repository arrow is the one shortcut the design allows, and
%% it is drawn because the code takes it: loading a screen reads through the same
%% repository protocols. Every write, and every business rule, still goes through a
%% use case, and no view or view model touches Core Data either way.

flowchart TB

    %% ---------- Human / system boundary ----------
    subgraph HUMAN["Outside the app"]
        direction LR
        T["<b>Renter</b><br/>documenting a<br/>rental property"]
        OTHER["<b>Renter</b><br/>holding a file in<br/>Photos, Files or Mail"]
    end

    %% ---------- Main app ----------
    subgraph APP["MoveProof: main app process"]
        direction TB
        V["<b>SwiftUI Views</b><br/>8 screens"]
        VM["<b>ViewModels</b><br/>8, @Observable"]
        UC["<b>Use Cases</b><br/>13 structs<br/>all business rules,<br/>all writes"]
        MODEL["<b>MoveProofModel</b><br/><b>.dataChanged()</b><br/>post-save choke point"]
        ERR["<b>Typed domain errors</b><br/>8 enums"]
        REPO["<b>Repository protocols</b><br/>Tenancy, Inspection, Evidence,<br/>EvidenceFileStore,<br/>InspectionSnapshotPublishing"]
        IMPL["<b>Repository implementations</b><br/>CoreData repositories,<br/>AppGroupEvidenceFileStore,<br/>WidgetSnapshotPublisher"]
    end

    CD[("<b>Core Data</b><br/>Tenancy → InspectionArea<br/>→ ConditionItem<br/>→ EvidenceItem")]

    %% ---------- Shared container ----------
    subgraph GROUP["App Group: group.com.krischuang.MoveProof"]
        direction LR
        G_EV[/"Evidence/<br/>evidence files"/]
        G_IN[/"SharedEvidenceInbox/"/]
        G_WI[/"Widget/snapshot.json<br/><b>counts, progress,<br/>deadline only</b>"/]
    end

    %% ---------- The renter again, and the two extension processes ----------
    HS["<b>Renter</b><br/>glancing at the<br/>Home Screen"]

    SE["<b>Share Extension</b><br/>SharedItemCollector<br/>file courier only"]
    WP["<b>Widget Extension</b><br/>InspectionProgressWidget<br/>systemSmall, systemMedium"]

    %% ---------- Primary flow: the renter captures evidence ----------
    T ==>|"1. attaches a photo of<br/>a scratched floorboard"| V
    V ==>|"2. attachPhoto"| VM
    VM ==>|"3. CaptureEvidenceUseCase"| UC
    UC ==>|"4. domain value types"| REPO
    REPO ==>|"5."| IMPL
    IMPL ==>|"6a. WRITE file"| G_EV
    IMPL ==>|"6b. WRITE metadata"| CD
    VM ==>|"7. after the write<br/>committed"| MODEL
    MODEL ==>|"8. refreshPublishedSnapshot()"| UC
    IMPL ==>|"9. WRITE snapshot,<br/>reloadTimelines"| G_WI
    G_WI ==>|"10. READ"| WP
    WP ==>|"11. progress"| HS

    %% ---------- Secondary flow: a file arrives from another app ----------
    OTHER -->|"Share Sheet"| SE
    SE -->|"WRITE file<br/>+ metadata"| G_IN
    G_IN -->|"READ, then drained by<br/>ImportSharedEvidenceUseCase"| UC

    %% ---------- Loading a screen: reads use the same protocols, no use case ----------
    VM -. "read-only screen loading<br/>(no rule, no write)" .-> REPO

    %% ---------- Refusals return to the renter in domain language ----------
    UC -. "throws" .-> ERR
    ERR -. "what happened,<br/>what to do next" .-> V

    %% ---------- Styling ----------
    classDef human  fill:#fff4e6,stroke:#d9822b,stroke-width:2px,color:#000
    classDef domain fill:#eaf7ea,stroke:#3d8b40,stroke-width:2px,color:#000
    classDef shared fill:#eaf1fb,stroke:#2f6fb5,stroke-width:2px,color:#000
    classDef ext    fill:#f4ecfb,stroke:#7a4fb5,stroke-width:2px,color:#000
    classDef store  fill:#fdeef0,stroke:#c0394b,stroke-width:2px,color:#000
    classDef layer  fill:#ffffff,stroke:#666,color:#000

    class T,HS,OTHER human
    class UC,ERR,MODEL domain
    class G_EV,G_IN,G_WI shared
    class SE,WP ext
    class CD store
    class V,VM,REPO,IMPL layer
