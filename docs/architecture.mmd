%% MoveProof — architecture and primary use-case data flow
%% (comment)
%% Render:  npx @mermaid-js/mermaid-cli -i docs/architecture.mmd -o architecture.png -b white
%% or paste into https://mermaid.live
%% (comment)
%% Reads top to bottom. The human boundary is the top row; the two extension
%% processes are on the right; everything between the Views box and Core Data is
%% the main app, and each arrow downward is a layer the code may not skip.

flowchart TB

    %% ---------- Human boundary ----------
    subgraph HUMAN["👤 Tenant — outside the app"]
        direction LR
        T["Documenting a<br/>rental property"]
        HS["Home Screen<br/><i>glanced at</i>"]
        OTHER["Another app<br/>Photos · Files · Mail"]
    end

    %% ---------- Main app ----------
    subgraph APP["MoveProof — main app process"]
        direction TB

        V["<b>Views</b> (SwiftUI) — 8 screens<br/>Dashboard · Property setup · Rooms · Room detail<br/>Condition item · Evidence library · Evidence detail · Shared inbox"]

        VM["<b>ViewModels</b> (@Observable) — one per screen<br/><i>no NSManagedObjectContext, no fetch requests</i>"]

        UC["<b>Use Cases</b> (structs) — the business rules<br/>StartTenancyInspection · RecordConditionEvidence<br/>CompleteInspectionArea · ImportSharedEvidence<br/>CaptureEvidence · ReviewInspectionProgress"]

        ERR["<b>Typed domain errors</b><br/>TenantFacingError:<br/>what happened + what to do next"]

        REPO["<b>Repository protocols</b><br/>Tenancy · Inspection · Evidence<br/>EvidenceFileStore · SnapshotPublishing<br/><i>domain value types only</i>"]

        IMPL["<b>Core Data implementations</b><br/>CoreDataTenancy/Inspection/EvidenceRepository<br/>AppGroupEvidenceFileStore · WidgetSnapshotPublisher"]
    end

    CD[("<b>Core Data</b><br/>Tenancy → InspectionArea<br/>→ ConditionItem → EvidenceItem")]

    %% ---------- Shared container ----------
    subgraph GROUP["App Group — group.com.krischuang.MoveProof"]
        direction LR
        G_EV[/"Evidence/<br/>evidence files"/]
        G_IN[/"SharedEvidenceInbox/<br/>hand-off from the share sheet"/]
        G_WI[/"Widget/snapshot.json<br/><b>counts · progress · deadline only</b>"/]
    end

    %% ---------- Extensions ----------
    subgraph SHAREX["Share Extension process"]
        SE["ShareViewController<br/>+ SharedItemCollector<br/><i>file courier — no domain logic</i>"]
    end

    subgraph WIDGETX["Widget Extension process"]
        WP["InspectionProgressProvider<br/>↓<br/>systemSmall · systemMedium"]
    end

    %% ---------- Main vertical flow ----------
    T -->|taps| V
    V --> VM
    VM --> UC
    UC -. throws .-> ERR
    ERR -. "plain-language message" .-> V
    UC --> REPO
    REPO --> IMPL
    IMPL --> CD

    %% ---------- Share Extension path (primary use case) ----------
    OTHER -->|"shares a photo or PDF"| SE
    SE ==>|"① copies file + metadata"| G_IN
    G_IN ==>|"② drained by ImportSharedEvidenceUseCase"| UC
    IMPL ==>|"③ adopts the file"| G_EV
    IMPL ==>|"④ writes metadata"| CD

    %% ---------- Widget path ----------
    IMPL -->|"publishes reduced snapshot"| G_WI
    IMPL -.->|"WidgetCenter.reloadTimelines"| WP
    G_WI -->|"read-only"| WP
    WP --> HS

    %% ---------- Styling ----------
    classDef human fill:#fff4e6,stroke:#d9822b,stroke-width:2px,color:#000
    classDef rules fill:#eaf7ea,stroke:#3d8b40,stroke-width:2px,color:#000
    classDef shared fill:#eaf1fb,stroke:#2f6fb5,stroke-width:2px,color:#000
    classDef ext    fill:#f4ecfb,stroke:#7a4fb5,stroke-width:2px,color:#000
    classDef store  fill:#fdeef0,stroke:#c0394b,stroke-width:2px,color:#000
    classDef layer  fill:#ffffff,stroke:#666,color:#000

    class T,HS,OTHER human
    class UC,ERR rules
    class G_EV,G_IN,G_WI shared
    class SE,WP ext
    class CD store
    class V,VM,REPO,IMPL layer
