<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- MoveProof appears in the share sheet for images and for files, which
			     is how a PDF reaches it. It deliberately does not claim text, URLs or
			     video, so it stays out of the share sheet for the content it could
			     never file.
			     The file key is broader than the two types MoveProof actually keeps,
			     so a sharing app offering some other document type can still reach
			     the extension. That is handled rather than prevented:
			     SharedItemCollector only carries attachments conforming to image or
			     PDF, shows "Nothing MoveProof can store" if none do, and
			     ImportSharedEvidenceUseCase re-checks the type in the main app before
			     anything is filed. A UTI predicate here would narrow the sheet
			     slightly and move the decision into a plist, away from the code that
			     is tested. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>10</integer>
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>10</integer>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
	</dict>
</dict>
</plist>
